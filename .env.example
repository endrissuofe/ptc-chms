# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: npx auth secret   (or any long random string)
NEXTAUTH_SECRET=replace-with-a-long-random-string
LOG_LEVEL=info

# --- MongoDB (Docker) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_DB=ptc_chms
MONGO_APP_USER=ptc_app
MONGO_APP_PASSWORD=change-me-app
# Used when running `npm run dev` on your machine (outside Docker):
MONGODB_URI=mongodb://ptc_app:change-me-app@localhost:27017/ptc_chms?authSource=ptc_chms

# --- Mongo Express (http://localhost:8081) ---
ME_USER=admin
ME_PASSWORD=change-me-express

# --- SMS ---
# mock = log messages only (development). bulksmslive, termii or bulksmsnigeria = send for real.
SMS_PROVIDER=mock
SMS_SENDER_ID=PTCHAPEL
# BulkSMSLive: API key from bulksmslive.com > Profile > Get API Key.
# FORCEDND=1 also reaches MTN Do-Not-Disturb numbers (2 units per page on MTN).
BULKSMSLIVE_API_KEY=
BULKSMSLIVE_FORCEDND=1
BULKSMSNIGERIA_API_TOKEN=
# direct-refund (default) | direct-corporate | otp | dual-backup
BULKSMSNIGERIA_GATEWAY=direct-refund
# Termii: API key from the Termii dashboard. Channel "dnd" reaches Do-Not-Disturb numbers
# (needs a sender ID approved for transactional use); "generic" is the promotional route.
TERMII_API_KEY=
TERMII_CHANNEL=dnd
# Only if your Termii dashboard shows a different API address:
TERMII_BASE_URL=https://api.ng.termii.com

# --- Email alerts (morning follow-up report) ---
# mock = write to the log only. gmail = send from the church Gmail using an app password
# (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_PROVIDER=mock
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Ptchapel
# Links in emails point here (defaults to NEXTAUTH_URL).
APP_URL=

# --- Scheduled jobs ---
# Cron endpoints require: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-another-random-string

# --- Church settings ---
CHURCH_NAME=Ptchapel
CHURCH_SHORT_NAME=Ptchapel
TZ=Africa/Lagos

# --- Backups ---
BACKUP_KEEP_DAYS=14
